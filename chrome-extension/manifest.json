{
  "manifest_version": 3,
  "name": "FocusFlow Reels Switcher",
  "version": "1.3.0",
  "description": "Switches to an existing Instagram Reels tab while an AI agent is working.",
  "permissions": ["tabs", "windows"],
  "host_permissions": [
    "http://127.0.0.1:38473/*",
    "https://*.instagram.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/reels/*",
        "https://*.instagram.com/reel/*"
      ],
      "js": ["reels-watcher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-watcher.js"],
      "run_at": "document_idle"
    }
  ]
}
